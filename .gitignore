# Unity generated folders — never commit these
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# IDE
.vs/
.vscode/
.idea/
# Unity regenerates these; the sandbox's hand-written project file is the one exception.
*.csproj
!sandbox/*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash reports and caches
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
Assets/StreamingAssets/aa.meta
Assets/StreamingAssets/aa/*

# OS
.DS_Store
Thumbs.db

# Blender working files live outside the Unity project (see docs/OSM_IMPORT_PLAN.md)
*.blend1
*.osm

# Local compile/test cache (tools/check.sh)
tools/.cache/

# .NET build output (sandbox)
sandbox/bin/
sandbox/obj/
sandbox/out/
